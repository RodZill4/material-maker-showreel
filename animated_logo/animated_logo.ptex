				"instance": "vec4 $(name)_splines(vec2 uv) {\n\tvec2 edge_uv = vec2(0.0, 10000000.0);\n\tfloat closest = 1000.0;\n\tfloat signed_distance = 10000000.0;\n\tfor (int i = 0; i < $splines.length(); i += 4) {\n\t\tvec4 d = distance_to_cubic_bezier(uv, $splines[i], $splines[i+1], $splines[i+2], $splines[i+3]);\n\t\tif (abs(edge_uv.y) > abs(d.y)) {\n\t\t\tedge_uv = d.xy;\n\t\t}\n\t\tif (abs(closest) > abs(d.z)) {\n\t\t\tclosest = d.z;\n\t\t}\n\t}\n\tif (abs(edge_uv.y) < 0.0) {\n\t\treturn $in_edge(vec2(edge_uv.x, 0.5+0.5*edge_uv.y));\n\t} else if (closest > 0.0) {\n\t\treturn $in_fill(uv);\n\t}\n\treturn vec4(0.0);\n}",
