		{
			"name": "rotate",
			"node_position": {
				"x": 840,
				"y": 560
			},
			"parameters": {
				"t": "$myt"
			},
			"seed_int": 0,
			"shader_model": {
				"code": "float $(name_uv)_t = clamp($t, 0.0, 23.99);",
				"global": "vec2 get_animation_frame(vec2 uv, float t) {\n \tint it = int(t);\n    return (uv+vec2(float(it%8), float(it/8)))*0.125;\t\n}",
				"inputs": [
					{
						"default": "vec4($uv, 0.0, 1.0)",
						"label": "",
						"longdesc": "The input image",
						"name": "in",
						"shortdesc": "Input",
						"type": "rgba"
					}
				],
				"instance": "",
				"longdesc": "Rotates its input",
				"name": "Animate",
				"outputs": [
					{
						"longdesc": "Shows the rotated image",
						"rgba": "mix($in(get_animation_frame($uv, $(name_uv)_t)), $in(get_animation_frame($uv, $(name_uv)_t+1.0)), fract($(name_uv)_t))",
						"shortdesc": "Output",
						"type": "rgba"
					}
				],
				"parameters": [
					{
						"control": "None",
						"default": 0,
						"label": "Time",
						"longdesc": "The angle of the rotation",
						"max": 23,
						"min": 0,
						"name": "t",
						"shortdesc": "Angle",
						"step": 0.01,
						"type": "float"
					}
				],
				"shortdesc": "Rotate"
			},
			"type": "shader"
		},
